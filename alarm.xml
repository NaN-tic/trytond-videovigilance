<?xml version="1.0"?>
<tryton>
    <data>
        <record model="ir.ui.view" id="alarm_view_form">
            <field name="model">videovigilance.alarm</field>
            <field name="type">form</field>
            <field name="name">alarm_form</field>
        </record>
        <record model="ir.ui.view" id="alarm_view_list">
            <field name="model">videovigilance.alarm</field>
            <field name="type">tree</field>
            <field name="name">alarm_list</field>
        </record>
        <record model="ir.action.act_window" id="act_alarm">
            <field name="name">Alarmes</field>
            <field name="res_model">videovigilance.alarm</field>
        </record>
        <record model="ir.action.act_window.view" id="act_alarm_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="alarm_view_list"/>
            <field name="act_window" ref="act_alarm"/>
        </record>
        <record model="ir.action.act_window.view" id="act_alarm_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="alarm_view_form"/>
            <field name="act_window" ref="act_alarm"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_alarm_domain_pending">
            <field name="name">Pendents</field>
            <field name="sequence" eval="10"/>
            <field name="domain" eval="[('state', '=', 'pending')]" pyson="1"/>
            <field name="count" eval="True"/>
            <field name="act_window" ref="act_alarm"/>
        </record>
        <record model="ir.action.act_window.domain" id="act_alarm_domain_all">
            <field name="name">Totes</field>
            <field name="sequence" eval="20"/>
            <field name="domain" eval="[]" pyson="1"/>
            <field name="act_window" ref="act_alarm"/>
        </record>
        <menuitem action="act_alarm" parent="menu_videovigilance" id="menu_alarm" sequence="25"/>
        <record model="ir.ui.menu-res.group" id="menu_alarm_group_admin">
            <field name="menu" ref="menu_alarm"/>
            <field name="group" ref="group_admin"/>
        </record>
        <record model="ir.ui.menu-res.group" id="menu_alarm_group_reader">
            <field name="menu" ref="menu_alarm"/>
            <field name="group" ref="group_reader"/>
        </record>
        <record model="ir.model.access" id="access_alarm_default">
            <field name="model">videovigilance.alarm</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_alarm_reader">
            <field name="model">videovigilance.alarm</field>
            <field name="group" ref="group_reader"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_alarm_admin">
            <field name="model">videovigilance.alarm</field>
            <field name="group" ref="group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.button" id="alarm_mark_seen_button">
            <field name="model">videovigilance.alarm</field>
            <field name="name">mark_seen</field>
            <field name="string">Marcar com a vista</field>
        </record>
        <record model="ir.model.button-res.group" id="alarm_mark_seen_button_group_admin">
            <field name="button" ref="alarm_mark_seen_button"/>
            <field name="group" ref="group_admin"/>
        </record>
    </data>
</tryton>
