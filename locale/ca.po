msgctxt "model:ir.message,text:msg_camera_code_unique"
msgid "The camera code must be unique."
msgstr "El codi de la càmera ha de ser únic."

msgctxt "model:ir.message,text:msg_camera_detection_required"
msgid ""
"The camera must have person detection, motion detection or both enabled."
msgstr ""
"La càmera ha de tenir activada la detecció de persones, la de moviment o "
"totes dues."

msgctxt "model:ir.message,text:msg_event_period_invalid"
msgid "The end of the event cannot be earlier than its start."
msgstr "El final de l'esdeveniment no pot ser anterior a l'inici."

msgctxt "model:ir.message,text:msg_event_uid_unique"
msgid "The identifier of the event must be unique."
msgstr "L'identificador de l'esdeveniment ha de ser únic."

#, python-format
msgctxt "model:ir.message,text:msg_manager_number_invalid"
msgid ""
"The phone \"%(number)s\" of %(party)s cannot be dialed: it must have digits "
"only (the + becomes 00)."
msgstr ""
"El telèfon «%(number)s» de %(party)s no es pot marcar: ha de tenir només "
"xifres (el + es converteix en 00)."

#, python-format
msgctxt "model:ir.message,text:msg_play_prompt_failed"
msgid "The Yeastar PBX \"%(pbx)s\" could not play the audio: %(errmsg)s"
msgstr ""
"La centraleta Yeastar «%(pbx)s» no ha pogut reproduir l'àudio: %(errmsg)s"

#, python-format
msgctxt "model:ir.message,text:msg_prompt_upload_failed"
msgid "The audio could not be uploaded to the Yeastar PBX \"%(pbx)s\": %(errmsg)s"
msgstr ""
"No s'ha pogut pujar l'àudio a la centraleta Yeastar «%(pbx)s»: %(errmsg)s"

msgctxt "model:ir.message,text:msg_secret_key_invalid"
msgid ""
"The encryption key secret_key of trytond.conf is not valid (a Fernet key is "
"required)."
msgstr ""
"La clau de xifratge secret_key de trytond.conf no és vàlida (cal una clau "
"Fernet)."

msgctxt "model:ir.message,text:msg_secret_key_mismatch"
msgid ""
"The password cannot be decrypted: the key secret_key is not the one used to "
"store it."
msgstr ""
"No es pot desxifrar la contrasenya: la clau secret_key no és la que es va "
"usar per desar-la."

msgctxt "model:ir.message,text:msg_secret_key_missing"
msgid ""
"The encryption key is missing: define secret_key in the [videovigilance] "
"section of trytond.conf."
msgstr ""
"Falta la clau de xifratge: definiu secret_key a la secció [videovigilance] "
"de trytond.conf."

msgctxt "model:ir.message,text:msg_web_not_configured"
msgid ""
"No video surveillance web application is configured: the notices page cannot"
" be opened."
msgstr ""
"No hi ha cap aplicació web de videovigilància configurada: no es pot obrir "
"la pàgina d'avisos."

