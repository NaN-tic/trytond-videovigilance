<?xml version="1.0"?>
<tryton>
    <data>
        <record model="ir.ui.view" id="configuration_view_form">
            <field name="model">videovigilance.configuration</field>
            <field name="type">form</field>
            <field name="name">configuration_form</field>
        </record>
        <record model="ir.action.act_window" id="act_configuration">
            <field name="name">Configuració</field>
            <field name="res_model">videovigilance.configuration</field>
        </record>
        <record model="ir.action.act_window.view" id="act_configuration_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="configuration_view_form"/>
            <field name="act_window" ref="act_configuration"/>
        </record>
        <menuitem action="act_configuration" parent="menu_videovigilance" id="menu_configuration" sequence="40"/>
        <record model="ir.ui.menu-res.group" id="menu_configuration_group_admin">
            <field name="menu" ref="menu_configuration"/>
            <field name="group" ref="group_admin"/>
        </record>
        <record model="ir.ui.menu-res.group" id="menu_configuration_group_reader">
            <field name="menu" ref="menu_configuration"/>
            <field name="group" ref="group_reader"/>
        </record>
        <record model="ir.model.access" id="access_configuration_default">
            <field name="model">videovigilance.configuration</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_reader">
            <field name="model">videovigilance.configuration</field>
            <field name="group" ref="group_reader"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_admin">
            <field name="model">videovigilance.configuration</field>
            <field name="group" ref="group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>
    </data>
    <data noupdate="1">
        <record model="ir.cron" id="cron_check_service">
            <field name="method">videovigilance.configuration|check_service</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</tryton>
